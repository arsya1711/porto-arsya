{
  "name": "awexam-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "npm run build && node tests/browser-smoke.mjs",
    "go-live:check": "node tool/go-live-check.mjs",
    "go-live:roles": "node tool/role-smoke.mjs",
    "go-live:load-safe": "node tool/safe-load-check.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "check:functions": "npx -y deno check supabase/functions/admin-users/index.ts supabase/functions/student-login/index.ts supabase/functions/import-questions/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "4.8.69",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.14.0",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5"
  }
}
